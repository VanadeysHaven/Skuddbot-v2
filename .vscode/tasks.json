{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Bot",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "package"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "All Tests",
      "type": "shell",
      "command": "mvn",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Deploy Database",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build", "--force-recreate", "-d", "database"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Deploy to Docker",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build", "--force-recreate", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
